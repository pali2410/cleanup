<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CleanCore_App.Views.DeepScanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:CleanCore_App.Views"
    mc:Ignorable="d">

    <ScrollViewer Padding="28,24,28,32">
        <StackPanel Spacing="20" MaxWidth="1300" HorizontalAlignment="Stretch">

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="Deep Storage Analysis" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                    <TextBlock Text="Multi-tier file classification, category distribution, and reclaimable footprint analysis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="TargetDriveComboBox" MinWidth="160" />
                    <Button x:Name="AnalyzeButton" Content="Start Deep Analysis" Click="OnAnalyzeClick" Style="{ThemeResource AccentButtonStyle}" />
                    <Button x:Name="CancelButton" Content="Cancel" Click="OnCancelClick" Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <!-- Live Progress Card -->
            <Border x:Name="ProgressCard" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock x:Name="PhaseText" Text="Analyzing drive..." FontWeight="SemiBold" />
                        <TextBlock x:Name="SpeedText" Text="0 files/s" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <ProgressBar x:Name="ScanProgressBar" IsIndeterminate="True" Height="8" CornerRadius="4" />

                    <Grid>
                        <TextBlock x:Name="PathText" Text="Current folder: ..." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ScannedMetricsText" Text="0 files | 0 B" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Analysis Overview Stats Grid -->
            <Grid x:Name="OverviewStatsGrid" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Total Measured Content" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="TotalMeasuredText" Text="0 B" FontSize="24" FontWeight="Bold" />
                        <TextBlock x:Name="FilesCountText" Text="0 files indexed" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Potential Reclaimable Footprint" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="PotentialReclaimableText" Text="0 B" FontSize="24" FontWeight="Bold" Foreground="#EA4335" />
                        <TextBlock Text="Temporary files, caches, and obsolete logs" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Classification Coverage" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="CoverageText" Text="100%" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="InaccessibleText" Text="0 inaccessible items" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Category Breakdown Cards -->
            <TextBlock Text="Storage Breakdown by Category" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" Margin="0,8,0,0" />

            <ItemsControl x:Name="CategoryItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:CategorySummaryItem">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16,12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>

                                <!-- Category Info -->
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="{x:Bind Explanation}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Proportional Bar -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <ProgressBar Value="{x:Bind Percentage}" Maximum="100" Height="8" CornerRadius="4" />
                                    <TextBlock Text="{x:Bind PercentageDisplay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <!-- Size & File Count -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind SizeDisplay}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" />
                                    <TextBlock Text="{x:Bind CountDisplay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Bottom Actions -->
            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="16" Margin="0,12,0,0">
                <Grid>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Ready to optimize storage?" FontWeight="SemiBold" />
                        <TextBlock Text="Create a reviewable cleanup plan containing identified temporary candidates." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                    <Button Content="Prepare Cleanup Plan" Click="OnPreparePlanClick" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
