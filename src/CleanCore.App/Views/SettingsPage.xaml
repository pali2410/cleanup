<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CleanCore_App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="28,24,28,32">
        <StackPanel Spacing="24" MaxWidth="1000" HorizontalAlignment="Stretch">

            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Settings &amp; Configuration" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                <TextBlock Text="Scanner performance, exclusion policies, quarantine retention, and local LLM endpoints" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Appearance & Theme -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="Appearance &amp; Theme" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="Select your visual appearance preference. CleanCore adapts seamlessly to Windows 11 themes." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <RadioButton x:Name="DarkThemeRadio" Content="Dark Theme" IsChecked="True" Checked="OnThemeChanged" Tag="Dark" />
                        <RadioButton x:Name="LightThemeRadio" Content="Light Theme" Checked="OnThemeChanged" Tag="Light" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Scanner Performance & Concurrency -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel Spacing="14">
                    <TextBlock Text="Scanner Performance &amp; Bounded Concurrency" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="Control parallel filesystem enumeration threads. Higher concurrency speeds up SSDs while restrained settings reduce load on mechanical hard drives." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="ConcurrencySlider" Minimum="1" Maximum="16" Value="4" TickFrequency="1" StepFrequency="1" ValueChanged="OnConcurrencyChanged" />
                        <TextBlock Grid.Column="1" x:Name="ConcurrencyValueText" Text="4 Threads" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Safety & Low Space Notification Thresholds -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel Spacing="14">
                    <TextBlock Text="Capacity Thresholds &amp; Low Space Alerts" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="Define when CleanCore triggers warning and critical banners for system partitions." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />

                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Warning Threshold (% Free):" FontSize="12" FontWeight="SemiBold" />
                            <NumberBox x:Name="WarningThresholdBox" Value="10" SmallChange="1" LargeChange="5" ValueChanged="OnThresholdChanged" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Critical Threshold (% Free):" FontSize="12" FontWeight="SemiBold" />
                            <NumberBox x:Name="CriticalThresholdBox" Value="5" SmallChange="1" LargeChange="5" ValueChanged="OnThresholdChanged" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Local AI / Ollama Configuration -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel Spacing="14">
                    <TextBlock Text="Local AI Assistant Endpoint" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="Configure connection to locally running Ollama or compatible OpenAI local inference servers." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />

                    <TextBox x:Name="OllamaEndpointBox" Header="Inference Endpoint URL" Text="http://localhost:11434" />
                    <TextBox x:Name="OllamaModelBox" Header="Preferred Local Model Tag" Text="llama3:latest" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="AI Autonomy &amp; Tool Execution Level:" FontWeight="SemiBold" FontSize="12" />
                        <ComboBox x:Name="AutonomyComboBox" SelectedIndex="1">
                            <ComboBoxItem Content="Strict Manual Approval (All proposals require review)" />
                            <ComboBoxItem Content="Semi-Autonomous (Read-only tools auto-run, destructive gated)" />
                            <ComboBoxItem Content="Unattended Read-Only (Destructive actions completely blocked)" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Data & History Management -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="Data Privacy &amp; Local History" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="CleanCore stores scan metadata and chat interactions strictly in your local SQLite database with zero cloud telemetry." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Clear Cleanup History" Click="OnClearHistoryClick" />
                        <Button Content="Clear AI Chat Logs" Click="OnClearChatClick" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Save Confirmation Bar -->
            <Button Content="Save All Settings" Click="OnSaveSettingsClick" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Left" MinWidth="140" />

            <InfoBar x:Name="SettingsSavedBar" IsOpen="False" Severity="Success" Title="Settings Saved" Message="All configuration preferences have been saved to the local SQLite database." />
        </StackPanel>
    </ScrollViewer>
</Page>
