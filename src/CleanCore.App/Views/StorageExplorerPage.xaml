<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CleanCore_App.Views.StorageExplorerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:CleanCore.Core.Models"
    mc:Ignorable="d">

    <Grid Padding="28,24,28,28" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Controls -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="Storage Explorer" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                <TextBlock Text="Hierarchical folder breakdown, directory sizing, and file inspection" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="DriveSelector" MinWidth="160" SelectionChanged="OnDriveSelectionChanged" />
                <Button Content="Fast Scan" Click="OnFastScanClick" />
                <Button Content="Deep Scan" Click="OnDeepScanClick" Style="{ThemeResource AccentButtonStyle}" />
                <Button x:Name="CancelButton" Content="Cancel" Click="OnCancelClick" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- Filter & Search Toolbar -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Content="&#xE72B; Up" FontFamily="{ThemeResource SymbolThemeFontFamily}" Click="OnNavigateUpClick" />
                
                <AutoSuggestBox Grid.Column="1" x:Name="SearchBox" PlaceholderText="Search files and folders in current directory..." TextChanged="OnSearchTextChanged" QueryIcon="Find" />

                <ComboBox Grid.Column="2" x:Name="SortSelector" SelectedIndex="0" SelectionChanged="OnSortSelectionChanged">
                    <ComboBoxItem Content="Sort by Size (Desc)" />
                    <ComboBoxItem Content="Sort by Name (Asc)" />
                    <ComboBoxItem Content="Sort by Modified Date" />
                </ComboBox>

                <Button Grid.Column="3" Content="Copy Current Path" Click="OnCopyCurrentPathClick" />
            </Grid>
        </Border>

        <!-- Main Content Area: Progress and Items List -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Admin Elevation / Unlock Banner -->
            <InfoBar Grid.Row="0"
                     x:Name="AdminElevationBanner"
                     IsOpen="False"
                     Severity="Warning"
                     Title="Protected System Folders Detected"
                     Message="Folders like PerfLogs, Config.Msi, MSOCache, and System Volume Information require Administrator privileges."
                     Margin="0,0,0,12">
                <InfoBar.ActionButton>
                    <Button x:Name="AdminActionButton" Content="Restart as Administrator" Click="OnAdminActionButtonClick" Style="{ThemeResource AccentButtonStyle}" />
                </InfoBar.ActionButton>
                <InfoBar.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button x:Name="AdminUnlockButton" Content="Unlock Access for Current User" Click="OnUnlockAccessClick" />
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>

            <!-- Progress Bar -->
            <StackPanel Grid.Row="1" x:Name="LoadingPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressRing IsActive="True" Width="48" Height="48" />
                <TextBlock x:Name="LoadingStatusText" Text="Enumerating directory..." HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- File / Folder Items List -->
            <ListView Grid.Row="1"
                      x:Name="ItemsListView"
                      SelectionMode="Single"
                      DoubleTapped="OnItemDoubleTapped"
                      RightTapped="OnItemRightTapped">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:StorageNode">
                        <Grid Padding="12,8" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Folder/File Icon -->
                            <FontIcon Glyph="{x:Bind IconGlyph}"
                                      FontSize="20"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                      VerticalAlignment="Center" />

                            <!-- Name and Path -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" />
                                    <Border Visibility="{x:Bind HasPermissionDenied}" Background="#E81123" CornerRadius="4" Padding="6,2">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE72E;" Foreground="White" FontSize="10" />
                                            <TextBlock Text="Access Denied" Foreground="White" FontSize="10" FontWeight="Bold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Visibility="{x:Bind HasReparsePoint}" Background="#F7630C" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="Junction" Foreground="White" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind FullPath}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Modified Date -->
                            <TextBlock Grid.Column="2" Text="{x:Bind ModifiedDisplay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />

                            <!-- Size Badge -->
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="100">
                                <TextBlock Text="{x:Bind SizeDisplay}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right" />
                                <TextBlock Text="{x:Bind TypeDisplay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
