<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CleanCore_App.Views.AiAssistantPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:CleanCore.Core.Models"
    mc:Ignorable="d">

    <Grid Padding="28,24,28,28" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header & LLM Connection Status -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="AI Storage Assistant &amp; Orchestration" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                <TextBlock Text="Local LLM storage intelligence with typed tool execution, explanations, and approval gates" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border x:Name="StatusBadge" CornerRadius="6" Padding="8,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#EA4335" />
                        <TextBlock x:Name="StatusText" Text="Connecting to Ollama..." FontSize="12" />
                    </StackPanel>
                </Border>
                <ComboBox x:Name="ModelSelector" MinWidth="140" SelectionChanged="OnModelSelectionChanged" />
                <Button Content="Test Endpoint" Click="OnTestConnectionClick" />
            </StackPanel>
        </Grid>

        <!-- Chat Conversation Messages List -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="12" Padding="16">
            <ListView x:Name="ChatListView" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:AiChatMessage">
                        <Border Margin="0,6"
                                Padding="14,10"
                                CornerRadius="8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                MaxWidth="800">
                            <StackPanel Spacing="4">
                                <Grid>
                                    <TextBlock Text="{x:Bind RoleDisplay}" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind TimeDisplay}" FontSize="10" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Grid>
                                <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Prompt Suggestions Chips -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="What is consuming the most space on C:?" Click="OnChipClick" Tag="What is consuming the most space on C:?" />
                <Button Content="Show me files larger than 1 GB" Click="OnChipClick" Tag="Show me files larger than 1 GB" />
                <Button Content="Analyze my browser and developer caches" Click="OnChipClick" Tag="Analyze my browser and developer caches" />
                <Button Content="Prepare a cleanup plan for review" Click="OnChipClick" Tag="Prepare a cleanup plan for review" />
            </StackPanel>
        </ScrollViewer>

        <!-- Message Input Box & Send Button -->
        <Grid Grid.Row="3" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="PromptInputBox" PlaceholderText="Ask CleanCore AI about your storage, large files, or cleanup strategies..." KeyDown="OnPromptKeyDown" />
            <Button Grid.Column="1" x:Name="SendButton" Content="Send" Click="OnSendClick" Style="{ThemeResource AccentButtonStyle}" MinWidth="80" />
        </Grid>
    </Grid>
</Page>
