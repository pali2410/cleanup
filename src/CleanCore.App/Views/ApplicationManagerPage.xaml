<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CleanCore_App.Views.ApplicationManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:CleanCore.Core.Models"
    mc:Ignorable="d">

    <Grid Padding="28,24,28,28" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="Application Manager &amp; Storage Footprints" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                <TextBlock Text="Inventory installed software, correlate on-disk directory footprints, and inspect associated caches" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Measure Disk Folders" Click="OnMeasureFoldersClick" />
                <Button Content="Refresh Apps" Click="OnRefreshAppsClick" Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- Search Toolbar -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search applications by name or publisher..." TextChanged="OnSearchTextChanged" QueryIcon="Find" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock x:Name="AppCountText" Text="0 applications installed" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Applications List -->
        <Grid Grid.Row="2">
            <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressRing IsActive="True" Width="48" Height="48" />
                <TextBlock x:Name="LoadingText" Text="Scanning installed applications..." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ListView x:Name="AppsListView" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:AppInventoryItem">
                        <Grid Padding="12,10" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Glyph="&#xE71D;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />

                            <!-- App Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="{x:Bind VersionDisplay}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind PublisherDisplay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind InstallLocation}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Measured Folder Size -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0" MinWidth="110">
                                <TextBlock Text="Folder Footprint" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{x:Bind FolderSizeDisplay}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>

                            <!-- Cache Footprint -->
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,16,0" MinWidth="100">
                                <TextBlock Text="App Caches" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{x:Bind CacheSizeDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="#EA4335" />
                            </StackPanel>

                            <!-- Actions -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Content="Open Folder" Click="OnOpenFolderClick" Tag="{x:Bind}" />
                                <Button Content="Uninstall" Click="OnUninstallClick" Tag="{x:Bind}" Style="{ThemeResource AccentButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
